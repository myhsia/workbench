{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": ".git/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.git/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".git/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/.git/**",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm .git/**",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm **/.git/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/__pycache__/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/__pycache__/**",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm **/__pycache__/**",
      "effect": "deny"
    }
  ],
  "compaction": {
    "auto": false,
    "keep": {
      "tokens": 60000
    },
    "buffer": 25000
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 32768
  },
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "opencode",
        "effect": "deny"
      }
    ]
  },
  "agent": {
    "title": {
      "prompt": "{file:./prompts/title.txt}"
    },
    "plan": {
      "permission": {
        "edit": {
          "*": "deny",
          "{env:HOME}/.opencode/plan/**": "allow",
          "{env:TMPDIR}opencode/**": "allow",
          "/private{env:TMPDIR}opencode/**": "allow"
        },
        "bash": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        }
      }
    },
    "explore": {
      "permission": {
        "edit": {
          "*": "deny",
          "{env:TMPDIR}opencode/**": "allow",
          "/private{env:TMPDIR}opencode/**": "allow"
        },
        "bash": "allow",
        "task": "deny"
      }
    }
  },
  "providers": {
    "WestlakeHPC": {
      "name": "Westlake HPC",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://hpc-api.westlake.edu.cn/v1",
        "apiKey": "{env:WESTLAKE_API_KEY}"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek-V4.1-Flash",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1048576,
            "output": 393216
          }
        },
        "glm-flash": {
          "name": "GLM-5.3-Flash",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1048576,
            "output": 393216
          }
        },
        "Qwen": {
          "name": "Qwen 3.8",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1048576,
            "output": 393216
          }
        }
      }
    }
  }
}
