#!/usr/bin/env bash
# commit-msg (machine-wide, via core.hooksPath=~/.config/opencode/hooks):
# a commit that changes code, configuration, CI or output must either carry a
# guide change in the same commit or say why none was needed,
#
#   Guides-Reviewed: unchanged, because ...
#
# and a commit that changes a manuscript must carry the talk that presents it,
#
#   Talk-Reviewed: unchanged, because ...
#
# Docs-only commits pass the guide gate.  A repository without AGENTS.md and a
# skill is not checked; one without a context/<name>.tex and <name>-talk.tex
# pair is not checked for the talk.  --no-verify is the deliberate bypass.
set -u

msg_file="${1:-}"
[ -n "$msg_file" ] || exit 0

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$root" || exit 0

# Repositories with their own commit-msg hook keep it: core.hooksPath shadows
# .git/hooks, so chain explicitly.
local_hook="$(git rev-parse --absolute-git-dir 2>/dev/null)/hooks/commit-msg"
if [ -x "$local_hook" ] && [ "$local_hook" != "$0" ]; then
  "$local_hook" "$msg_file" || exit 1
fi

# Merge and revert commits are not authored changes.
git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && exit 0
head -1 "$msg_file" | grep -qE '^(Merge|Revert) ' && exit 0

# House style, every repository: the tracked Python files are linted for the
# keyword `=` spacing.  Tracked files only, so a generated output tree is never
# crawled.  Fails open: a missing interpreter or script must not block commits.
lint="$HOME/.config/opencode/scripts/style-lint.py"
if [ -f "$lint" ]; then
  py="$(command -v python3 || true)"
  if [ -n "$py" ]; then
    count="$(git ls-files -- '*.py' | wc -l | tr -d ' ')"
    if [ "${count:-0}" -gt 0 ]; then
      out="$(git ls-files -z -- '*.py' | xargs -0 "$py" "$lint" 2>&1)"
      rc=$?
      if [ "$rc" -ne 0 ]; then
        cat >&2 <<EOF
commit-msg: house style: spaces around '=' in keyword arguments.

$out

Run

    python3 $lint <paths>

to list them, or

    python3 $HOME/.config/opencode/scripts/style-fix.py <paths>

to fix the spacing.  --no-verify bypasses this check deliberately.
EOF
        exit 1
      fi
    fi
  else
    echo "commit-msg: python3 not found; skipping the style check." >&2
  fi
fi

# A manuscript and its talk move together.  Where a staged context/<name>.tex has
# a sibling <name>-talk.tex, the commit must also stage a *-talk.tex in that
# directory -- or say in a trailer why the talk needs no change.  Checked before
# the guide gate, because a Guides-Reviewed: trailer must not bypass it.
missing_talk=""
while IFS= read -r f; do
  case "$f" in
    *-talk.tex) continue ;;
  esac
  dir="$(dirname "$f")"
  case "$(basename "$f")" in
    *.tex) ;;
    *) continue ;;
  esac
  base="$(basename "$f" .tex)"
  [ -f "$dir/$base-talk.tex" ] || continue
  git diff --cached --name-only --diff-filter=ACMR -- "$dir" \
    | grep -qE '(^|/)[^/]+-talk\.tex$' && continue
  missing_talk="$f"
  break
done < <(git diff --cached --name-only --diff-filter=ACMR -- \
           ':(glob)**/context/*.tex' 'context/*.tex')

if [ -n "$missing_talk" ] && ! grep -qi '^Talk-Reviewed:' "$msg_file"; then
  cat >&2 <<EOF
commit-msg: the manuscript and its talk move together.

This commit stages

    $missing_talk

without any *-talk.tex beside it, and the message carries no trailer.  Either

  * carry the change into the deck and its transcript in this commit, or
  * add a trailer saying why the talk needs no change:

      Talk-Reviewed: unchanged, because ...

The talk quotes the manuscript and introduces no result of its own, so a number,
a figure, a page map or a claim that changes in the text changes on the slides
too.  --no-verify bypasses this check deliberately.
EOF
  exit 1
fi

# Opt-in: only repositories that keep a guide and a skill are checked.
[ -f AGENTS.md ] || exit 0
skilldir=""
for d in .opencode/skills skills; do
  if [ -f "$d/SKILL.md" ] || ls -d "$d"/*/SKILL.md >/dev/null 2>&1; then
    skilldir="$d"
    break
  fi
done
[ -n "$skilldir" ] || exit 0

# The author reviewed the guides and recorded why they did not change.
grep -qi '^Guides-Reviewed:' "$msg_file" && exit 0

# A guide is part of the commit: nothing else to check.
if git diff --cached --name-only -- AGENTS.md "$skilldir" | grep -q .; then
  exit 0
fi

gate="$HOME/.config/opencode/scripts/guides-due.sh"
[ -x "$gate" ] || exit 0
out="$("$gate" --staged "$root" 2>&1)"
rc=$?
[ "$rc" -ne 0 ] && exit 0

cat >&2 <<EOF
commit-msg: the guides were not updated.

$out

This commit changes code, configuration, CI or output, but neither AGENTS.md
nor $skilldir/ is staged, and the message carries no trailer.  Either

  * update the guides in this commit, or
  * add a trailer saying why they need no change:

      Guides-Reviewed: unchanged, because ...

The machine-global guides (~/.config/opencode: AGENTS.md, skills/,
opencode.json) follow the same rule; a convention that is not specific to this
repository belongs there.  --no-verify bypasses this check deliberately.
EOF
exit 1
